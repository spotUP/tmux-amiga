# tmux 3.6a and libevent 2.1.12 for AmigaOS 3.x + ixemul 48.2 (UP-Term).
# bebbo's gcc, GG ncurses 5.5 (the rig's), vtcon's libixcompat. amiga/
# holds the hand-written configuration (configure does not run for m68k).
AGCC    ?= $(HOME)/opt/amiga/bin/m68k-amigaos-gcc
AAR     ?= $(HOME)/opt/amiga/bin/m68k-amigaos-ar
NCURSES ?= $(HOME)/Code/vtcon/build/rig/vtc/pkgs/ncurses-5.5-1-p-bin-m68k
CFLAGS  = -mcrt=ixemul -O2 -fgnu89-inline -Wall -Wno-unused -Wno-pointer-sign
B       = build

EV_SRCS = event.c evthread.c buffer.c bufferevent.c bufferevent_sock.c \
          bufferevent_filter.c bufferevent_pair.c bufferevent_ratelim.c \
          evmap.c log.c evutil.c evutil_rand.c evutil_time.c strlcpy.c \
          select.c signal.c
EV_OBJS = $(addprefix $(B)/libevent/,$(EV_SRCS:.c=.o))
EV_INC  = -Iamiga/libevent -Ilibevent -Ilibevent/include -Ilibevent/compat

all: $(B)/libevent.a $(B)/evprobe

$(B)/evprobe: amiga/evprobe.c $(B)/libevent.a
	$(AGCC) $(CFLAGS) $(EV_INC) -o $@ amiga/evprobe.c $(B)/libevent.a -lixcompat

$(B)/libevent/%.o: libevent/%.c amiga/libevent/event2/event-config.h
	@mkdir -p $(B)/libevent
	$(AGCC) $(CFLAGS) $(EV_INC) -c -o $@ $<

$(B)/libevent.a: $(EV_OBJS)
	rm -f $@
	$(AAR) rcs $@ $(EV_OBJS)
