# tmux 3.6a and libevent 2.1.12 for AmigaOS 3.x + ixemul 48.2 (UP-Term).
# bebbo's gcc, GG ncurses 5.5 (the rig's), vtcon's libixcompat. amiga/
# holds the hand-written configuration (configure does not run for m68k).
# The workspace directory that holds this repo and its siblings (the upterm
# meta-repo creates it); the sibling defaults below hang off it.
UPTERM_ROOT ?= $(abspath $(CURDIR)/..)
AGCC    ?= $(HOME)/opt/amiga/bin/m68k-amigaos-gcc
AAR     ?= $(HOME)/opt/amiga/bin/m68k-amigaos-ar
NCURSES ?= $(UPTERM_ROOT)/vtcon/build/rig/vtc/pkgs/ncurses-5.5-1-p-bin-m68k
CFLAGS  = -mcrt=ixemul -O2 -fgnu89-inline -Wall -Wno-unused -Wno-pointer-sign
B       = build

EV_SRCS = event.c evthread.c buffer.c bufferevent.c bufferevent_sock.c \
          bufferevent_filter.c bufferevent_pair.c bufferevent_ratelim.c \
          evmap.c log.c evutil.c evutil_rand.c evutil_time.c strlcpy.c \
          select.c signal.c
EV_OBJS = $(addprefix $(B)/libevent/,$(EV_SRCS:.c=.o))
EV_INC  = -Iamiga/libevent -Ilibevent -Ilibevent/include -Ilibevent/compat

all: $(B)/libevent.a $(B)/evprobe $(B)/tmux-bin

$(B)/evprobe: amiga/evprobe.c $(B)/libevent.a
	$(AGCC) $(CFLAGS) $(EV_INC) -o $@ amiga/evprobe.c $(B)/libevent.a -lixcompat

$(B)/libevent/%.o: libevent/%.c amiga/libevent/event2/event-config.h
	@mkdir -p $(B)/libevent
	$(AGCC) $(CFLAGS) $(EV_INC) -c -o $@ $<

$(B)/libevent.a: $(EV_OBJS)
	rm -f $@
	$(AAR) rcs $@ $(EV_OBJS)

# tmux: its sources (Makefile.am's dist_tmux_SOURCES, cmd-parse.c as the
# tarball has it generated, osdep-unknown.c), the compat/ files for what
# ixemul lacks, and the AmigaOS pieces in amiga/.
VTCON   ?= $(UPTERM_ROOT)/vtcon
TM_SRCS = alerts.c arguments.c attributes.c cfg.c client.c cmd-attach-session.c \
          cmd-bind-key.c cmd-break-pane.c cmd-capture-pane.c cmd-choose-tree.c cmd-command-prompt.c cmd-confirm-before.c \
          cmd-copy-mode.c cmd-detach-client.c cmd-display-menu.c cmd-display-message.c cmd-display-panes.c cmd-find-window.c \
          cmd-find.c cmd-if-shell.c cmd-join-pane.c cmd-kill-pane.c cmd-kill-server.c cmd-kill-session.c \
          cmd-kill-window.c cmd-list-buffers.c cmd-list-clients.c cmd-list-keys.c cmd-list-panes.c cmd-list-sessions.c \
          cmd-list-windows.c cmd-load-buffer.c cmd-lock-server.c cmd-move-window.c cmd-new-session.c cmd-new-window.c \
          cmd-paste-buffer.c cmd-pipe-pane.c cmd-queue.c cmd-refresh-client.c cmd-rename-session.c cmd-rename-window.c \
          cmd-resize-pane.c cmd-resize-window.c cmd-respawn-pane.c cmd-respawn-window.c cmd-rotate-window.c cmd-run-shell.c \
          cmd-save-buffer.c cmd-select-layout.c cmd-select-pane.c cmd-select-window.c cmd-send-keys.c cmd-server-access.c \
          cmd-set-buffer.c cmd-set-environment.c cmd-set-option.c cmd-show-environment.c cmd-show-messages.c cmd-show-options.c \
          cmd-show-prompt-history.c cmd-source-file.c cmd-split-window.c cmd-swap-pane.c cmd-swap-window.c cmd-switch-client.c \
          cmd-unbind-key.c cmd-wait-for.c cmd.c colour.c control-notify.c control.c \
          environ.c file.c format.c format-draw.c grid-reader.c grid-view.c \
          grid.c hyperlinks.c input-keys.c input.c job.c key-bindings.c \
          key-string.c layout-custom.c layout-set.c layout.c log.c menu.c \
          mode-tree.c names.c notify.c options-table.c options.c paste.c \
          popup.c proc.c regsub.c resize.c screen-redraw.c screen-write.c \
          screen.c server-acl.c server-client.c server-fn.c server.c session.c \
          spawn.c status.c style.c tmux.c tty-acs.c tty-features.c \
          tty-keys.c tty-term.c tty.c utf8-combined.c utf8.c window-buffer.c \
          window-client.c window-clock.c window-copy.c window-customize.c window-tree.c window.c \
          xmalloc.c cmd-parse.c osdep-unknown.c
TM_COMPAT = asprintf.c base64.c clock_gettime.c closefrom.c err.c explicit_bzero.c freezero.c getdtablecount.c getline.c getpeereid.c getprogname.c htonll.c ntohll.c imsg.c imsg-buffer.c memmem.c reallocarray.c recallocarray.c setproctitle.c strcasestr.c strlcat.c strlcpy.c strndup.c strnlen.c strtonum.c vis.c unvis.c getopt_long.c
TM_OBJS = $(addprefix $(B)/tmux/,$(TM_SRCS:.c=.o)) \
          $(addprefix $(B)/tmux/compat/,$(TM_COMPAT:.c=.o)) $(B)/tmux/amiga/utf8proc.o \
          $(B)/tmux/amiga/vspawn.o
TM_INC  = -Iamiga/tmux -Iamiga -Itmux -Itmux/compat $(EV_INC) -I$(NCURSES)/include -I$(NCURSES)/include/ncurses \
          -I$(VTCON)/engine
TM_DEFS = -DHAVE_CONFIG_H -include amiga/tmux/config.h

$(B)/tmux/%.o: tmux/%.c amiga/tmux/config.h
	@mkdir -p $(dir $@)
	$(AGCC) $(CFLAGS) $(TM_DEFS) $(TM_INC) -c -o $@ $<

$(B)/tmux/amiga/%.o: amiga/%.c amiga/tmux/config.h
	@mkdir -p $(dir $@)
	$(AGCC) $(CFLAGS) $(TM_DEFS) $(TM_INC) -c -o $@ $<

$(B)/tmux-bin: $(TM_OBJS) $(B)/libevent.a
	$(AGCC) -mcrt=ixemul -s -o $@ $(TM_OBJS) $(B)/libevent.a -L$(NCURSES)/lib -lncurses -lixcompat
